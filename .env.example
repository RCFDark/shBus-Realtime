# 本地开发环境变量模板
# 复制为 .env.development.local（文件名别改：Vite 只在 dev 模式加载，
# 生产构建不会读取，这样 token 不会被打进公开的前端产物）
#
#   cp .env.example .env.development.local

# 生产构建时前端请求的 API 前缀 —— 填你自己的 Cloudflare Worker 地址
# 例：VITE_API_BASE=https://shbus-api.xxx.workers.dev/api
# 留空则使用默认的 '/api'（本地由 vite dev server 代理到官方接口）
VITE_API_BASE=

# 本地开发直连官方接口用的凭证（生产走 Worker 时这两个值不生效）
# token 失效时执行：npm run token
VITE_TICKET_TOKEN=
VITE_USER_ID=
